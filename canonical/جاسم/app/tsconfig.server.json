{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./contracts/*"],
      "@db/*": ["./db/*"]
    }
  },
  "include": ["api", "contracts", "db"],
  "exclude": [
    "api/core",
    "api/connectors",
    "api/services",
    "api/routes",
    "api/webhook-handlers.ts",
    "api/lib",
    "api/routers/agents.ts",
    "api/routers/task.ts",
    "api/routers/bubble.ts",
    "api/routers/conversation.ts",
    "api/routers/capability.ts",
    "api/routers/entity.ts",
    "api/routers/approval.ts",
    "api/routers/notifications.ts",
    "api/routers/security.ts",
    "api/routers/dna.ts",
    "api/routers/external-actions.ts",
    "api/routers/worlds.ts",
    "api/routers/core-evolution.ts",
    "api/routers/jasim.ts",
    "api/routers/stream.ts"
  ]
}
