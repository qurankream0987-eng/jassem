# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # 16+ chars; JWT signing and generated-input encryption

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
# JASIM Generative DNA artifact storage
JASIM_DNA_ARTIFACT_DIR=./data/dna-artifacts

# Optional Ed25519 package attestation key. Keep the real private key only in a
# secret manager; never commit it. Newlines may be encoded as \n.
JASIM_PACKAGE_SIGNING_KEY_ID=
JASIM_PACKAGE_SIGNING_PRIVATE_KEY=

# Optional JSON array of reviewed declarative external connector definitions.
# Definitions contain only env:JASIM_* secret references, never secret values.
JASIM_EXTERNAL_CONNECTORS_JSON=
# Example referenced secret name (choose provider-specific names in deployment):
JASIM_PARTNER_PAYMENT_TOKEN=

# Optional reviewed regional providers. A provider is not registered unless its
# reference is present. Keep the actual values in the deployment secret store.
JASIM_MOYASAR_SECRET_REF=env:JASIM_MOYASAR_SECRET_KEY
JASIM_MOYASAR_SECRET_KEY=
JASIM_SHIPDAY_API_KEY_REF=env:JASIM_SHIPDAY_API_KEY
JASIM_SHIPDAY_API_KEY=

# Inbound provider webhooks. Routes fail closed until these references exist.
# Shipday documents the validation value in the HTTP `token` header (max 32 chars).
JASIM_SHIPDAY_WEBHOOK_TOKEN_REF=env:JASIM_SHIPDAY_WEBHOOK_TOKEN
JASIM_SHIPDAY_WEBHOOK_TOKEN=

# Moyasar documents a shared webhook secret but deployments must explicitly set
# the verified delivery mode/header observed in the provider configuration.
JASIM_MOYASAR_WEBHOOK_SECRET_REF=env:JASIM_MOYASAR_WEBHOOK_SECRET
JASIM_MOYASAR_WEBHOOK_SECRET=
JASIM_MOYASAR_WEBHOOK_AUTH_MODE=
JASIM_MOYASAR_WEBHOOK_HEADER=

# External reliability worker intervals (production only).
JASIM_RECONCILIATION_INTERVAL_MS=30000
JASIM_CONNECTOR_HEALTH_INTERVAL_MS=300000

# Separate Core Evolution Lab service. Deploy behind HTTPS on a dedicated host.
# The image must already exist locally and must be pinned by sha256 digest.
JASIM_CORE_LAB_BIND=127.0.0.1
JASIM_CORE_LAB_PORT=4010
JASIM_CORE_LAB_TOKEN=
JASIM_CORE_LAB_PROVIDER_ID=core-lab:docker
JASIM_CORE_LAB_SOURCE_ARTIFACT_ROOT=./data/dna-artifacts
JASIM_CORE_LAB_BASELINE_ARTIFACT_ROOT=./data/kernel-baselines
# Durable queue uses DATABASE_URL. Payloads, results and evidence use one
# content-addressed store. Choose filesystem or s3.
JASIM_CORE_LAB_ARTIFACT_STORE=filesystem
JASIM_CORE_LAB_ARTIFACT_ROOT=./data/core-lab-artifacts
# JASIM_CORE_LAB_ARTIFACT_STORE=s3
JASIM_CORE_LAB_S3_BUCKET=
JASIM_CORE_LAB_S3_PREFIX=jasim-core-lab
JASIM_CORE_LAB_S3_ENDPOINT=
JASIM_CORE_LAB_S3_EXPECTED_OWNER=
JASIM_CORE_LAB_WORKER_ID=
JASIM_CORE_LAB_LEASE_MS=60000
JASIM_CORE_LAB_POLL_MS=1000
JASIM_CORE_LAB_IMAGE=
JASIM_CORE_LAB_DOCKER_BIN=docker
JASIM_CORE_LAB_WORK_ROOT=
# Required only while building the evaluator image; it must also be digest-pinned.
JASIM_CORE_LAB_NODE_IMAGE=
JASIM_CORE_LAB_IMAGE_TAG=jasim-core-lab:local
